# Private deployment settings: copy to .env and fill these in.
# Generate a stable private token, for example: openssl rand -hex 32
MIGAKU_API_TOKEN=
# Absolute path to your installed extension directory containing manifest.json.
MIGAKU_EXTENSION_PATH=
# Optional private username/password file for automatic session recovery (mode 600).
# Defaults to CREDS in a native checkout. Use /data/CREDS with Docker.
# MIGAKU_CREDENTIALS_FILE=/absolute/path/to/CREDS
# Opt-in only: reviewed EA 1.31.0.17 helper profile; authenticated flow unverified.
# MIGAKU_ENABLE_EXPERIMENTAL_131017=1
